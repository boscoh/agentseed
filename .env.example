# The default provider/model is the first configured provider in agentseed/models.json.

# Bedrock uses the standard AWS credential chain (AWS_PROFILE / AWS_REGION):
#   export AWS_PROFILE=my-profile
#   export AWS_REGION=ap-southeast-2
#   aws sso login --profile my-profile

# Other providers require their API keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=...   (or GEMINI_API_KEY)
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...

# Ollama base URL (defaults to http://localhost:11434/v1):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Seconds a successful /agent/activate check is reused (default 300):
# ACTIVATE_TTL_S=300

# Maximum number of built agents kept besides the startup one (default 8):
# AGENT_CACHE_SIZE=8
