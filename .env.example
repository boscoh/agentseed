# Provider selection: bedrock (default), openai, anthropic, groq, or ollama.
# CHAT_SERVICE=bedrock

# Bedrock uses the standard AWS credential chain (AWS_PROFILE / AWS_REGION):
#   export AWS_PROFILE=my-profile
#   export AWS_REGION=ap-southeast-2
#   aws sso login --profile my-profile

# OpenAI / Anthropic / Groq require their API keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# Ollama base URL (defaults to http://localhost:11434/v1):
# OLLAMA_BASE_URL=http://localhost:11434/v1
